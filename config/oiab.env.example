# Overland In A Box base configuration.
OIAB_HOSTNAME=overland.daemonadventures.net
OIAB_BIND_HOST=0.0.0.0
OIAB_PORT_HTTP=8080
OIAB_PORT_HTTPS=8443
OIAB_DATA_DIR=/srv/trailer/data/oiab
OIAB_DB_PATH=/data/oiab/db/oiab.sqlite
OIAB_DEV_MODE=false
OIAB_MAP_PACK_REGISTRY=/data/oiab/maps/registry.json
OIAB_ENABLE_OPTIONAL_SERVICES=false
OIAB_DEFAULT_MAP_APP=maps_v2
OIAB_CERT_MODE=existing
OIAB_ALLOW_DOCKER_CONTROL=true

# Install RaspAP host integration by default as the core OIAB network manager.
# Set to false only if you explicitly do not want the host-side Wi-Fi/AP layer.
OIAB_INSTALL_RASPAP=true

# Docker socket group on the host. The OIAB core container joins this group so
# host-level helpers (power controls, RaspAP status/actions) can talk to the
# mounted Docker socket without running the whole app as root.
OIAB_DOCKER_GID=998

# Host-level Raspberry Pi network mode manager. These are read by the
# systemd-managed host scripts, not by Docker networking itself.
OIAB_NETWORK_CONFIG=/data/oiab/config/network.env
OIAB_ETH_IFACE=eth0
OIAB_AP_IFACE=wlan0
OIAB_WAN_WIFI_IFACE=wlan1
OIAB_AP_SSID='Daemon Adventures'
OIAB_AP_COUNTRY=US
OIAB_AP_CHANNEL=6
OIAB_AP_SUBNET=192.168.8.0/24
OIAB_AP_IP=192.168.8.2
OIAB_DHCP_RANGE=192.168.8.3,192.168.8.20,12h
OIAB_RASPAP_PORT=8097
OIAB_RASPAP_SCHEME=http
# Optional explicit RaspAP URL override.
# Leave blank to use the deployment-aware default:
# - proxied same-origin path: https://<current-host>/apps/raspap/
# - local/dev fallback when no host context is available: http://<current-host>:8097/
OIAB_RASPAP_URL=

# Large content mounts. In a trailer/head-unit install these should point at
# the existing external SSD locations instead of duplicating media under the
# app-state directory.
OIAB_MAP_PACKS_DIR=/srv/trailer/data/oiab/maps/packs
OIAB_MEDIA_DIR=/srv/trailer/media
OIAB_MUSIC_DIR=/srv/trailer/media/music
OIAB_BOOKS_DIR=/srv/trailer/media/books/Ebooks
OIAB_COMICS_DIR=/srv/trailer/media/books/Comics
OIAB_ZIM_DIR=/srv/trailer/iiab/zims
OIAB_WIKIS_DIR=/srv/trailer/wikis
OIAB_ROMS_DIR=/srv/trailer/roms
OIAB_MINECRAFT_DIR=/srv/trailer/minecraft/server
OIAB_CRAFTY_CONFIG_DIR=/srv/trailer/crafty/docker/config
OIAB_CRAFTY_SERVER_NAME=Trailer Pi Minecraft
OIAB_FILEBROWSER_ROOT=/srv/trailer
OIAB_FILEBROWSER_DB_DIR=/srv/trailer/data/oiab/services/filebrowser/database
OIAB_FILEBROWSER_CONFIG_DIR=/srv/trailer/data/oiab/services/filebrowser/config
JELLYFIN_CONFIG_DIR=/srv/trailer/jellyfin/config
JELLYFIN_CACHE_DIR=/srv/trailer/jellyfin/cache
OIAB_EMULATORJS_DIR=/data/oiab/services/emulatorjs/data
KOMGA_PROXY_TARGET=http://host.docker.internal:25601
KOMGA_READER_AUTH_HEADER=
KOMGA_READER_AUTH_FILE_HOST=/dev/null

# Docker deployment.
# Compose reads these values when run with:
#   docker compose --env-file config/oiab.env up -d --build
OIAB_UID=1000
OIAB_GID=1000
OIAB_HTTP_PUBLISHED_PORT=80
OIAB_CORE_IMAGE=oiab-core:latest
OIAB_CORE_CONTAINER=oiab-core

# GPS in Docker defaults to reading host gpsd through Docker's host gateway.
# On the Pi, configure gpsd to listen for non-localhost clients or use a host-network override later.
OIAB_GPSD_HOST=host.docker.internal
OIAB_GPSD_PORT=2947

# Optional service published ports.
JELLYFIN_PORT=8096
KOMGA_PORT=25601
KIWIX_PORT=8081
FILEBROWSER_PORT=8091
FILEBROWSER_INTERNAL_URL=http://filebrowser:80
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASSWORD=change-me
MINECRAFT_MAP_PORT=8123
MINECRAFT_ADMIN_PORT=8452
# If Crafty rejects direct host:port access, route through the legacy trusted
# hostname instead:
# MINECRAFT_ADMIN_URL=https://minecraft-admin.{overland_domain}/
MINECRAFT_JAVA_PORT=25565
MINECRAFT_BEDROCK_PORT=19132
MINECRAFT_TYPE=PAPER
MINECRAFT_MEMORY=2G
MINECRAFT_RCON_PASSWORD=change-me
