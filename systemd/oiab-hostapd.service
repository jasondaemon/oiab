[Unit]
Description=OIAB field-mode Wi-Fi access point
After=network-pre.target
Wants=network-pre.target

[Service]
Type=simple
ExecStartPre=/usr/bin/test -f /run/oiab-network/hostapd.conf
ExecStart=/usr/sbin/hostapd /run/oiab-network/hostapd.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
